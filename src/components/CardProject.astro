---
interface Props {
  title: string;
  description: string;
  image: string;
  demoUrl?: string;
  repoUrl?: string;
  stack?: string[];
}

const { title, description, image, demoUrl, repoUrl, stack = [] } = Astro.props;
---

<article
  class="group relative rounded-2xl border border-slate-200/80 bg-white/80 backdrop-blur-sm overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-sky-500/10 hover:border-sky-300/60 dark:border-white/10 dark:bg-[#111111]/80 dark:hover:border-zinc-600 dark:hover:bg-[#161616] dark:hover:shadow-2xl dark:hover:shadow-black/70"
>
  <div
    class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-sky-400 via-indigo-500 to-sky-400 opacity-0 group-hover:opacity-100 transition-opacity z-10"
  >
  </div>

  <div
    class="border-b border-slate-200/80 bg-slate-100/50 aspect-video overflow-hidden dark:border-zinc-800/80 dark:bg-[#090909]"
  >
    <img
      src={image}
      alt={`Captura del proyecto ${title}`}
      loading="lazy"
      class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
    />
  </div>

  <div class="p-5">
    <h3
      class="text-lg font-bold tracking-tight text-slate-900 mb-1.5 dark:text-zinc-100"
    >
      {title}
    </h3>

    <p class="text-sm text-slate-600 leading-relaxed mb-4 dark:text-zinc-400">
      {description}
    </p>

    {
      stack.length > 0 && (
        <ul class="flex flex-wrap gap-2 mb-5">
          {stack.map((tech) => (
            <li class="rounded-full border border-slate-200 bg-slate-100/60 px-2.5 py-0.5 text-xs font-semibold text-slate-700 dark:border-zinc-800 dark:bg-zinc-900/90 dark:text-zinc-300">
              {tech}
            </li>
          ))}
        </ul>
      )
    }

    <div
      class="flex items-center gap-3 pt-4 border-t border-slate-200/60 dark:border-zinc-800/80"
    >
      {
        demoUrl && (
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-bold text-white bg-gradient-to-r from-sky-500 to-indigo-600 px-3.5 py-1.5 rounded-lg hover:opacity-90 transition-all hover:shadow-md hover:shadow-sky-500/20 dark:from-zinc-100 dark:to-zinc-200 dark:text-zinc-950 dark:hover:bg-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
            Demo
          </a>
        )
      }

      {
        repoUrl && (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-700 border border-slate-200 px-3.5 py-1.5 rounded-lg hover:bg-slate-100 hover:text-slate-900 transition-colors dark:text-zinc-300 dark:border-zinc-800 dark:bg-zinc-900/50 dark:hover:bg-zinc-800 dark:hover:text-white dark:hover:border-zinc-700"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-4 h-4"
            >
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.3 3.5 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22 0 1.6-.02 2.89-.02 3.29 0 .32.22.7.83.58C20.56 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
            </svg>
            Código
          </a>
        )
      }
    </div>
  </div>
</article>
