---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Colección de proyectos y prácticas de desarrollo web hechos por Walter.",
  image = "/og-image.png",
} = Astro.props;

import { ModeToggle } from "@/components/ModdeToggle";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url.origin,
);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <script is:inline>
      const theme =
        localStorage.getItem("theme") ??
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "theme-light");
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#030303" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url.origin)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url.origin)} />

    <link rel="preconnect" href="https://rsms.me" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="relative min-h-screen overflow-x-hidden bg-[#faf8f2] text-slate-900 antialiased dark:bg-[#030303] dark:text-slate-100 transition-colors"
  >
    <!-- Capa 1: Fondo Base (Lattice en Light / Gradiente en Dark) -->
    <div
      class="pointer-events-none absolute inset-0 dark:hidden"
      style="background: linear-gradient(rgba(14,165,233,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(14,165,233,0.08) 1px, transparent 1px); background-size: 40px 40px; mix-blend-mode: normal;"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 hidden dark:block"
      style="background: linear-gradient(135deg, #030303 0%, #111111 42%, #1c1c1c 72%, #090909 100%); mix-blend-mode: normal;"
      aria-hidden="true"
    >
    </div>

    <!-- Capa 2: Aura Primaria -->
    <div
      class="pointer-events-none absolute inset-0 blur-[150px] md:blur-[216px] dark:blur-[13px] dark:md:blur-[18px]"
      style="background: var(--aura-primary); mix-blend-mode: var(--aura-blend, normal);"
      aria-hidden="true"
    >
    </div>

    <!-- Capa 3: Aura Secundaria (Solo activa en Light Mode) -->
    <div
      class="pointer-events-none absolute inset-0 blur-[125px] md:blur-[180px] dark:hidden"
      style="background: radial-gradient(circle at 30% 70%, rgba(99,102,241,0.15) 0%, transparent 40%); mix-blend-mode: normal;"
      aria-hidden="true"
    >
    </div>

    <!-- Contenido Principal -->
    <div class="relative z-10 flex min-h-screen flex-col justify-between">
      <div>
        <div class="fixed top-4 right-4 z-50">
          <ModeToggle client:load />
        </div>

        <main class="mx-auto max-w-7xl px-4 pt-12">
          <slot />
        </main>
      </div>

      <footer
        class="mt-24 border-t border-slate-200/80 dark:border-slate-800/80"
      >
        <div
          class="mx-auto max-w-7xl px-4 py-8 text-center text-sm text-slate-500 dark:text-slate-400"
        >
          Hecho con Astro & Tailwind CSS. ❤️
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --aura-primary: radial-gradient(
      circle at 50% 50%,
      rgba(56, 189, 248, 0.25) 0%,
      transparent 50%
    );
    --aura-blend: normal;
  }

  .dark {
    --aura-primary: radial-gradient(
      ellipse 45% 55% at 68% 38%,
      rgba(161, 161, 170, 0.16) 0%,
      transparent 65%
    );
    --aura-blend: screen;
  }
</style>
